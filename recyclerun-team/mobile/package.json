{
  "name": "bin2bucks-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "prestart": "../scripts/mobile/use-lan-api.sh",
    "preandroid": "../scripts/mobile/use-lan-api.sh",
    "preios": "../scripts/mobile/use-lan-api.sh",
    "preweb": "../scripts/mobile/use-lan-api.sh",
    "start": "expo start --tunnel -c",
    "start:dev-client": "expo start --dev-client -c",
    "start:lan": "expo start --lan -c",
    "start:tunnel": "expo start --tunnel -c",
    "prebuild": "expo prebuild --clean",
    "android": "expo run:android",
    "android:dev-client": "expo run:android",
    "ios": "expo run:ios",
    "ios:dev-client": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.1.10",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-location": "~19.0.7",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.3",
    "typescript": "~5.9.2"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "vitest": "^4.0.18"
  }
}
