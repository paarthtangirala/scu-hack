# ── AI Vision ──
AMD_API_KEY=YOUR_AMD_API_KEY
# Optional fallback (off by default to keep demos sponsor-forward)
ENABLE_CLAUDE_FALLBACK=0
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Optional: override AMD hosted vision model name
AMD_VISION_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct

# Vision parse guardrails
VISION_MIN_LBS=0.1
VISION_MAX_LBS=500.0

# Gemini live preview
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_LIVE_MODEL=gemini-2.0-flash
GEMINI_LIVE_TIMEOUT_SECONDS=12
GEMINI_LIVE_SESSION_TTL_SECONDS=600
GEMINI_LIVE_MAX_FRAME_BYTES=1500000
GEMINI_LIVE_MIN_FRAME_INTERVAL_MS=1000
GEMINI_LIVE_MIN_LBS=0.1
GEMINI_LIVE_MAX_LBS=500.0

# ── Voice ──
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY

# ── Phone calls ──
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Maps ──
VITE_GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_KEY

# ── Server ──
FLASK_ENV=development
PORT=5050
