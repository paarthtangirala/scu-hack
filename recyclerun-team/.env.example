# ── AI Vision ──
AMD_API_KEY=your_amd_key
# Optional fallback (off by default to keep demos sponsor-forward)
# ENABLE_CLAUDE_FALLBACK=1
# ANTHROPIC_API_KEY=your_anthropic_key

# Optional: override AMD hosted vision model name
# AMD_VISION_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct

# ── Voice ──
ELEVENLABS_API_KEY=your_elevenlabs_key

# ── Phone calls ──
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+14155550100

# ── Maps ──
VITE_GOOGLE_MAPS_KEY=your_google_maps_key

# ── Server ──
FLASK_ENV=development
PORT=5000
